# Public base URL of the deployed docs site.
# Used by lib/metadata.ts for absolute URLs (OG images, canonical links, etc.).
# Leave unset for local dev (falls back to http://localhost:3000).
DOCS_BASE_URL=https://docs.example.com

# Endpoint that returns the elepay 2.0 error code catalog.
# Consumed at:
#   - install/build time by scripts/snapshot-error-codes.ts (writes data/error-codes.snapshot.json fallback)
#   - request time by components/ErrorCodeTable.tsx (ISR via unstable_cache)
# When unset, the snapshot script writes an empty stub and the table renders zero rows
# (no network call is made).
DOCS_ERROR_CODES_URL=https://charge-api.sandbox-elepay.com/error-codes
