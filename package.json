    "fumadocs-openapi": "^10.8.1",
    "fumadocs-ui": "^16.8.8",
    "lucide-react": "^0.577.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
