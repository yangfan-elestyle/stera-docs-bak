{
  "name": "@sterasmartone/docs",
  "title": "stera smart one Docs",
  "description": "Documentation for stera smart one (SMCC).",
  "version": "0.1.10",
  "private": true,
  "scripts": {
    "generate:data": "bun run scripts/generate-openapi-json.ts && bun run scripts/generate-openapi.ts",
    "import:seed": "bun run scripts/import-seed.ts",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "^1.5.2",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@scalar/snippetz": "^0.9.8",
    "fumadocs-core": "^16.8.8",
    "fumadocs-mdx": "^14.3.2",
    "fumadocs-openapi": "^10.8.1",
    "fumadocs-ui": "^16.8.8",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.15.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "^1.3.14",
    "@types/mdx": "^2.0.13",
    "@types/node": "24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.3"
  },
  "patchedDependencies": {
    "fumadocs-openapi@10.8.1": "patches/fumadocs-openapi@10.8.1.patch",
    "fumadocs-ui@16.8.8": "patches/fumadocs-ui@16.8.8.patch"
  }
}
