{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Single Worker `elepay-docs`. Environments are version-based, not env-based:
  //   production  == active deployment    (master ← develop PR merge → `opennextjs-cloudflare deploy`)
  //   staging     == preview alias `staging`
  //                  (develop merge / workflow_dispatch → `opennextjs-cloudflare upload --preview-alias staging`)
  //                  Stable URL: `staging-elepay-docs.<account-subdomain>.workers.dev`.
  // `DOCS_ENV` is still set at build time (staging vs product) so each version
  // embeds the matching error-codes snapshot.
  // Business domains are owned outside this Cloudflare account.
  // AWS maps docs.* (and docs.stg.*) to the corresponding workers.dev URL.
  // Keep Wrangler free of routes/custom domains/zone_name here.
  "name": "elepay-docs",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Built-in logging + Tail Worker compatibility; required for `wrangler tail`.
  "observability": { "enabled": true },
  // Explicit 30s CPU ceiling (Paid plan default) to guard against silent regressions.
  "limits": { "cpu_ms": 30000 },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "elepay-docs",
    },
  ],
}
